{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% form_theme requestForm 'bootstrap_5_layout.html.twig' %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <div class="p-5 bg-white rounded border-black col-4 offset-4 mt-5">
    <h1 class="text-center text-pd-yellow my-3 d-flex ">Reset your password</h1>

    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <div>
            <small>
                Veuillez saisir votre adresse email, nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </small>
        </div>

        <button class="btn btn-primary col-12 my-3">Envoyer un e-mail de réinitialisation</button>
        </div>
    {{ form_end(requestForm) }}
{% endblock %}
